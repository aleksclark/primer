# syntax=docker/dockerfile:1
#
# content-ingest reconciler. Periodic Nomad batch job that converges
# Radarr/Sonarr/yt-dlp/Jellyfin/TV toward curriculum/content-manifest.yaml.
# The curriculum YAML is baked into the image so the job needs no git checkout.

FROM golang:1.25-alpine AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/ ./server/
RUN cd server && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /content-ingest ./cmd/content-ingest

FROM alpine:3.21
# Alpine's yt-dlp package lags YouTube player changes; install the latest
# release. Unpinned /releases/latest is intentional until a known-good dated
# tag is verified — see agent_docs/runbooks/youtube-shows.md.
# nodejs is required for yt-dlp --js-runtimes node (Gate A / YouTube challenges).
RUN apk add --no-cache ca-certificates ffmpeg python3 curl nodejs \
	&& curl -fsSL -o /usr/local/bin/yt-dlp \
		https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
	&& chmod a+rx /usr/local/bin/yt-dlp \
	&& yt-dlp --version \
	&& node --version

COPY --from=build /content-ingest /usr/local/bin/content-ingest
COPY curriculum/ /curriculum/

ENV INGEST_MANIFEST_PATH=/curriculum/content-manifest.yaml
ENV INGEST_REVIEW_PATH=/curriculum/content-review.yaml
ENV INGEST_REPORT_DIR=/var/log/content-ingest
ENV INGEST_YTDLP_PATH=yt-dlp
# Canonical YouTube root (job env still wins). Host: /mnt/moosefs/media/tv/Primer.
ENV INGEST_YTDLP_OUTPUT_DIR=/media/tv/Primer
# Global INGEST_YTDLP_ARCHIVE_PATH is deprecated/unused. Per-show archives live at
# {OutputDir}/Shows/<slug>/.ytdlp-archive.txt (managed by the reconciler).

WORKDIR /
ENTRYPOINT ["content-ingest"]
CMD ["apply"]
