# syntax=docker/dockerfile:1
# Standalone Primer Agents service. This image contains only the agents module
# and binary; it never bundles LMS, Studio, Identity, or TV code.
FROM golang:1.26.6-bookworm AS build
WORKDIR /src/primer-agents
COPY primer-agents/go.mod primer-agents/go.sum ./
RUN GOWORK=off go mod download
COPY primer-agents/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /primer-agents ./cmd/primer-agents

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /primer-agents /usr/local/bin/primer-agents
USER 65534:65534
ENV PRIMER_AGENTS_HOST=0.0.0.0 \
    PRIMER_AGENTS_PORT=8091 \
    PRIMER_AGENTS_ENV=production \
    PRIMER_AGENTS_WORKER_ENABLED=false
EXPOSE 8091
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD wget -qO- http://127.0.0.1:${PRIMER_AGENTS_PORT:-8091}/healthz || exit 1
# Required at deployment: PRIMER_AGENTS_DATABASE_URL,
# PRIMER_AGENTS_IDENTITY_JWKS_URL, PRIMER_AGENTS_IDENTITY_ISSUER, and explicit
# non-billable/local provider configuration when workers are enabled.
ENTRYPOINT ["/usr/local/bin/primer-agents"]
