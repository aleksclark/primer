# syntax=docker/dockerfile:1
# Standalone Primer Agents service. This image contains only the agents module
# and binary; it never bundles LMS, Studio, Identity, or TV code.
FROM golang:1.25-alpine AS build
WORKDIR /src/primer-agents
COPY primer-agents/go.mod primer-agents/go.sum ./
RUN GOWORK=off go mod download
COPY primer-agents/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /primer-agents ./cmd/primer-agents

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /primer-agents /primer-agents
ENV PRIMER_AGENTS_HOST=0.0.0.0 \
    PRIMER_AGENTS_PORT=8091 \
    PRIMER_AGENTS_ENV=production \
    PRIMER_AGENTS_WORKER_ENABLED=false
EXPOSE 8091
# Required at deployment: PRIMER_AGENTS_DATABASE_URL,
# PRIMER_AGENTS_IDENTITY_JWKS_URL, PRIMER_AGENTS_IDENTITY_ISSUER, and an
# explicit non-billable/local provider configuration when workers are enabled.
ENTRYPOINT ["/primer-agents"]
