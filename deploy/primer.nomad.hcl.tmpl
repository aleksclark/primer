job "primer" {
  datacenters = ["home"]
  type        = "service"

  group "primer" {
    count = 1

    network {
      port "http" {}
    }

    service {
      name     = "primer"
      port     = "http"
      provider = "nomad"

      tags = [
        "traefik.enable=true",
        "traefik.http.routers.primer.rule=Host(`primer.fleet.clark.team`) || Host(`primer.clark.team`)",
        "traefik.http.routers.primer.entrypoints=websecure",
        "traefik.http.routers.primer.tls.certresolver=letsencrypt",
      ]

      check {
        type     = "http"
        path     = "/api/v1/health"
        interval = "30s"
        timeout  = "5s"
      }
    }

    task "primer" {
      driver = "docker"

      config {
        image = "ghcr.io/aleksclark/primer:${IMAGE_TAG}"
        ports = ["http"]
      }

      env {
        PORT          = "${NOMAD_PORT_http}"
        HOST          = "0.0.0.0"
        ENV           = "production"
        DATABASE_URL  = "${DATABASE_URL}"
        CORS_ORIGINS  = "https://primer.fleet.clark.team,https://primer.clark.team"
        SERVICE_TOKEN = "${SERVICE_TOKEN}"
      }

      resources {
        cpu    = 200
        memory = 128
      }
    }
  }
}
