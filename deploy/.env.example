# Copy to deploy/.env and fill in. deploy/.env is git-ignored.
NOMAD_ADDR=http://192.168.0.24:4646
NOMAD_TOKEN=<nomad acl token>
DATABASE_URL=postgres://primer:<password>@192.168.0.24:5432/primer?sslmode=disable
# Shared secret the TV server presents on X-Service-Token when reporting
# instructional time. Leave unset and the ingest endpoint is unauthenticated.
SERVICE_TOKEN=<shared secret, also set as TV_PRIMER_SERVICE_TOKEN on the TV server>

# ── TV server (deploy/primer-tv.nomad.hcl.tmpl) ──────────────────────────────
TV_DATABASE_URL=postgres://primer:<password>@192.168.0.24:5432/primer_tv?sslmode=disable
TV_JELLYFIN_BASE_URL=http://192.168.0.24:8096
TV_JELLYFIN_API_KEY=<jellyfin api key>
TV_JELLYFIN_USER_ID=<jellyfin user id>
# Guards the TV admin API, which hands out device pairing codes.
TV_ADMIN_API_KEY=<shared secret>
TV_PRIMER_BASE_URL=https://primer.fleet.clark.team
TV_PRIMER_SERVICE_TOKEN=<same value as SERVICE_TOKEN above>

# Optional overrides:
# IMAGE_REPO=ghcr.io/aleksclark/primer
# IMAGE_TAG=<defaults to git short sha>
