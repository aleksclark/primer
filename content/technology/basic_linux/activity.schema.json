{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primer.local/schemas/student-activity-v1.json",
  "title": "Primer student activity document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "summary", "kind", "subjectCode", "standards", "content"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "kind": {"enum": ["terminal", "typing"]},
    "subjectCode": {"type": "string", "minLength": 1},
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/standardRef"}
    },
    "content": {"$ref": "#/$defs/content"},
    "minRunnerVersion": {"type": "string"},
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "referenceSolution": {"$ref": "#/$defs/referenceSolution"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "terminal"}}},
      "then": {
        "properties": {
          "content": {
            "required": ["terminal"],
            "not": {"required": ["typing"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "typing"}}},
      "then": {
        "properties": {
          "content": {
            "required": ["typing"],
            "not": {"required": ["terminal"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "standardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "role"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9]+(?:\\.[A-Z0-9]+)+$"},
        "role": {"enum": ["primary", "reinforcement"]},
        "weight": {"type": "number"},
        "evidencePolicy": {"$ref": "#/$defs/evidencePolicy"}
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "statusRequirements"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "statusRequirements": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "instructions", "tasks", "checks"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1},
        "blocks": {
          "type": "array",
          "items": {"$ref": "#/$defs/instructionBlock"}
        },
        "terminal": {"$ref": "#/$defs/terminal"},
        "typing": {"$ref": "#/$defs/typing"},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/task"}
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        },
        "hints": {
          "type": "array",
          "items": {"$ref": "#/$defs/hint"}
        },
        "tutor": {"$ref": "#/$defs/tutor"},
        "progression": {"$ref": "#/$defs/progression"},
        "artifacts": {"$ref": "#/$defs/artifacts"}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeProfile", "fixtures"],
      "properties": {
        "runtimeProfile": {"enum": ["coreutils-basic", "text-processing"]},
        "fixtures": {
          "type": "array",
          "items": {"$ref": "#/$defs/fixture"}
        },
        "initialCwd": {"$ref": "#/$defs/safePath"},
        "shell": {"type": "string"}
      }
    },
    "typing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptSetId", "prompts"],
      "properties": {
        "promptSetId": {"type": "string", "minLength": 1},
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/typingPrompt"}
        },
        "ordering": {"type": "string"},
        "timeLimitSec": {"type": "integer", "minimum": 0},
        "successWpm": {"type": "number", "minimum": 0},
        "successAccuracy": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "typingPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1},
        "category": {"type": "string"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "type": {"enum": ["file", "directory"]},
        "content": {"type": "string"},
        "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "instructions", "completion"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "instructions": {"type": "string", "minLength": 1},
        "kind": {"enum": ["action", "short_response"]},
        "prerequisites": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        },
        "completion": {"$ref": "#/$defs/checkTree"},
        "hintIds": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        },
        "optional": {"type": "boolean"},
        "response": {"$ref": "#/$defs/responseTask"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "short_response"}}, "required": ["kind"]},
          "then": {"required": ["response"]}
        }
      ]
    },
    "responseTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "rubric"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1, "maxLength": 8000},
        "maxChars": {"type": "integer", "minimum": 1, "maximum": 8000},
        "parentReviewRequired": {"type": "boolean"},
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rubricCriterion"}
        }
      }
    },
    "rubricCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "instructionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": ["prose", "vocabulary", "example", "warning", "question", "practice", "parent_note", "resource"]
        },
        "title": {"type": "string"},
        "text": {"type": "string", "maxLength": 8000},
        "terms": {
          "type": "array",
          "items": {"$ref": "#/$defs/vocabularyTerm"}
        },
        "input": {"type": "string", "maxLength": 8000},
        "output": {"type": "string", "maxLength": 8000},
        "explanation": {"type": "string", "maxLength": 8000},
        "resource": {"$ref": "#/$defs/resourceRef"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["prose", "warning", "question", "practice", "parent_note"]}}},
          "then": {"required": ["text"]}
        },
        {
          "if": {"properties": {"kind": {"const": "vocabulary"}}},
          "then": {"required": ["terms"]}
        },
        {
          "if": {"properties": {"kind": {"const": "resource"}}},
          "then": {"required": ["resource"]}
        }
      ]
    },
    "vocabularyTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "mediaType", "label"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "mediaType": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "byteSize": {"type": "integer", "minimum": 0, "maximum": 262144}
      }
    },
    "checkTree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkTree"}
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkTree"}
        },
        "checkId": {"$ref": "#/$defs/id"},
        "optional": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["all"]},
        {"required": ["any"]},
        {"required": ["checkId"]}
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "params"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": ["file_exists", "file_not_exists", "content_equals", "content_contains", "content_match", "path_type", "path_mode", "cwd", "command_properties", "pipeline_output", "typing_metrics", "response_submitted"]
        },
        "optional": {"type": "boolean"},
        "params": {"type": "object"},
        "stages": {
          "type": "array",
          "items": {"enum": ["fixture", "task", "final"]},
          "uniqueItems": true
        },
        "evidenceBearing": {"type": "boolean"},
        "invariantAt": {
          "type": "array",
          "items": {"enum": ["fixture", "after_task", "final"]},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "file_exists"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathOnly"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "file_not_exists"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathOnly"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "content_equals"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathValue"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "content_contains"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathValue"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "content_match"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathPattern"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "path_type"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathType"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "path_mode"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathMode"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "cwd"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPathOnly"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "command_properties"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsCommandProperties"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "pipeline_output"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsPipelineOutput"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "typing_metrics"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsTypingMetrics"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "response_submitted"}}},
          "then": {"properties": {"params": {"$ref": "#/$defs/paramsResponseSubmitted"}}}
        }
      ]
    },
    "paramsResponseSubmitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId"],
      "properties": {
        "taskId": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/id"}
      }
    },
    "paramsPathOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"}
      }
    },
    "paramsPathValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "value": {"type": "string"}
      }
    },
    "paramsPathPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pattern"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "pattern": {"type": "string", "minLength": 1}
      }
    },
    "paramsPathType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "type": {"enum": ["file", "directory", "symlink"]}
      }
    },
    "paramsPathMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "mode": {"type": "string", "pattern": "^[0-7]{3,4}$"}
      }
    },
    "paramsCommandProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "args": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exitCode": {"type": "integer"}
      }
    },
    "paramsPipelineOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {"type": "string"},
        "contains": {"type": "string"},
        "pattern": {"type": "string"}
      },
      "anyOf": [
        {"required": ["value"]},
        {"required": ["contains"]},
        {"required": ["pattern"]}
      ]
    },
    "paramsTypingMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_wpm": {"type": "number"},
        "minWpm": {"type": "number"},
        "min_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "minAccuracy": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "anyOf": [
        {"required": ["min_wpm", "min_accuracy"]},
        {"required": ["minWpm", "minAccuracy"]},
        {"required": ["min_wpm", "minAccuracy"]},
        {"required": ["minWpm", "min_accuracy"]}
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "level": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "tutor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "misconceptions": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "goalSummary": {"type": "string"}
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowReset", "resumeFromTask", "requireInOrder"],
      "properties": {
        "allowReset": {"type": "boolean"},
        "maxAttempts": {"type": "integer", "minimum": 0},
        "resumeFromTask": {"type": "boolean"},
        "requireInOrder": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxFiles": {"type": "integer", "minimum": 0},
        "maxBytesEach": {"type": "integer", "minimum": 0},
        "maxBytesTotal": {"type": "integer", "minimum": 0},
        "allowedTypes": {"type": "array", "items": {"type": "string"}},
        "retainDays": {"type": "integer", "minimum": 0}
      }
    },
    "referenceSolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "description": {"type": "string"},
        "deterministic": {"type": "boolean"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/referenceStep"}
        }
      }
    },
    "referenceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "workDir": {"$ref": "#/$defs/safePath"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "stdin": {"type": "string"}
      }
    },
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
