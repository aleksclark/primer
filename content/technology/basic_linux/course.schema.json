{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primer.local/schemas/course-document-v1.json",
  "title": "Primer course document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "title", "subjectCode", "activities"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "subjectCode": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "parentDescription": {"type": "string"},
    "revisionPolicy": {"enum": ["latest_published", "pinned_digest"]},
    "pacingReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nominalWeeks": {"type": "integer", "minimum": 0},
        "nominalDaysPerWeek": {"type": "integer", "minimum": 0},
        "nominalMinutesPerDay": {"type": "integer", "minimum": 0},
        "masteryBased": {"type": "boolean"}
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "slug"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "file": {"type": "string", "minLength": 1},
          "module": {"type": "string"},
          "capstone": {"type": "boolean"},
          "continuity": {"$ref": "#/$defs/continuity"},
          "metadata": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity", "requires"],
        "properties": {
          "activity": {"type": "string"},
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "requirement": {"enum": ["completed", "approaching", "mastered"]},
          "description": {"type": "string"}
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity", "kind"],
        "properties": {
          "activity": {"type": "string"},
          "kind": {"enum": ["evidence", "parent_review"]},
          "standards": {
            "type": "array",
            "items": {"type": "string"}
          },
          "description": {"type": "string"}
        }
      }
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["forActivity", "branchSlug"],
        "properties": {
          "forActivity": {"type": "string"},
          "branchSlug": {"type": "string"},
          "kind": {"enum": ["remediation", "reinforcement"]},
          "description": {"type": "string"}
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "activities": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "continuityDefaults": {"$ref": "#/$defs/continuity"},
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  },
  "$defs": {
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["fresh", "optional_previous", "required_project", "portfolio_review"]}
      }
    }
  }
}
