# Copy to .env.local for local overrides (gitignored by Vite convention).

# Public contact inbox used by mailto CTAs
# VITE_CONTACT_EMAIL=you@example.com

# Canonical origin for production (no trailing slash)
# VITE_SITE_ORIGIN=https://invest.example.com

# production | staging | preview
# VITE_SITE_ENV=staging

# Set to 1 only on the real production host that should be crawled
# VITE_ALLOW_INDEX=0

# Force noindex regardless of other flags
# VITE_NOINDEX=1

# Log analytics events to the console in dev
# VITE_ANALYTICS_DEBUG=1
