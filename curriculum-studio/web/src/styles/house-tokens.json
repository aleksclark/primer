{
  "format": "agentbase-house-tokens/v1",
  "name": "Editorial Instrument",
  "version": "1.0.0",
  "dimensionUnit": "px",
  "theme": {
    "canonical": "dark",
    "parity": "light"
  },
  "accent": {
    "allowed": {
      "violet": "#B98BFF",
      "cyan": "#3DE0F0",
      "mint": "#7CFFB2"
    },
    "selected": "#B98BFF",
    "ink": "#15170E",
    "policy": "Choose exactly one allowed accent per product."
  },
  "font": {
    "product": "Archivo",
    "editorial": "Newsreader",
    "technical": "IBM Plex Mono"
  },
  "type": {
    "display": { "desktop": 48, "mobile": 32, "weight": 400, "lineHeight": 1.05, "family": "editorial" },
    "pageTitle": { "desktop": 30, "mobile": 22, "weight": 700, "lineHeight": 1.12, "letterSpacing": "-0.022em", "family": "product" },
    "section": { "size": 15, "weight": 600, "lineHeight": 1.2, "family": "product" },
    "lede": { "size": 14, "weight": 400, "lineHeight": 1.55, "family": "product" },
    "body": { "size": 14, "weight": 400, "lineHeight": 1.6, "family": "product" },
    "bodyCompact": { "size": 13, "weight": 400, "lineHeight": 1.5, "family": "product" },
    "control": { "size": 13, "weight": 500, "lineHeight": 1.0, "family": "product" },
    "label": { "size": 12, "weight": 500, "lineHeight": 1.3, "family": "product" },
    "metadata": { "size": 11, "weight": 400, "lineHeight": 1.5, "family": "technical" },
    "eyebrow": { "size": 10, "weight": 500, "lineHeight": 1.0, "letterSpacing": "0.16em", "transform": "uppercase", "family": "technical" },
    "data": { "desktop": 30, "mobile": 22, "weight": 500, "lineHeight": 1.0, "family": "technical", "numeric": "tabular" },
    "code": { "size": 12, "weight": 400, "lineHeight": 1.7, "family": "technical" }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48
  },
  "density": {
    "default": "comfortable",
    "compactPolicy": "explicit task or local product requirement only",
    "comfortable": { "control": 34, "row": 40, "gutter": 28 },
    "compact": { "control": 28, "row": 30, "gutter": 20 },
    "mobileFloor": { "control": 44, "row": 48, "gutter": 16 }
  },
  "layout": {
    "navDesktop": 218,
    "navTablet": 186,
    "readingWidth": 960,
    "desktopReference": 1280,
    "tabletReference": 834,
    "mobileReference": 390
  },
  "shape": {
    "radiusSmall": 2,
    "radiusMedium": 2,
    "radiusPill": 999,
    "rule": 1,
    "selectedRule": 2,
    "focusWidth": 2,
    "focusOffset": 2
  },
  "icon": {
    "grid": 24,
    "stroke": 1.75,
    "renderDefault": 16,
    "renderCompact": 14,
    "renderEmphasis": 18,
    "lineCap": "round",
    "lineJoin": "round",
    "color": "currentColor"
  },
  "elevation": {
    "policy": "none except modal and toast",
    "modal": "0 18px 48px rgb(0 0 0 / 55%)",
    "toast": "0 12px 32px rgb(0 0 0 / 32%)"
  },
  "motion": {
    "enter": "170ms ease-out",
    "reduced": "0.001ms"
  },
