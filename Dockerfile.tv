# syntax=docker/dockerfile:1
#
# The TV server and its admin SPA. Mirrors the LMS Dockerfile stage for stage;
# the two are separate images because they are separate services with separate
# databases and lifecycles.

# ── Stage 1: generate the TV OpenAPI spec from the API type signatures ──────
FROM golang:1.25-alpine AS spec
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/ ./server/
RUN cd server && go run ./cmd/openapi-gen -service tv -out /openapi.yaml

# ── Stage 2: build the TV admin SPA (TS client generated from the spec) ─────
FROM node:22-alpine AS web
WORKDIR /src/tv-web
COPY tv-web/package.json tv-web/package-lock.json ./
RUN npm ci
COPY tv-web/ ./
COPY --from=spec /openapi.yaml ./openapi.yaml
RUN npm run build

# ── Stage 3: build the server with the SPA embedded ─────────────────────────
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/ ./server/
# Replace the placeholder with the real SPA bundle before compiling.
RUN rm -rf server/internal/tv/spa/dist
COPY --from=web /src/tv-web/dist/ ./server/internal/tv/spa/dist/
RUN cd server && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /tv-server ./cmd/tv-server

# ── Final: minimal runtime image ─────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /tv-server /tv-server

ENV TV_PORT=8081
EXPOSE 8081

# Migrations are embedded and applied automatically on startup. Configure with
# TV_DATABASE_URL, TV_JELLYFIN_BASE_URL, TV_JELLYFIN_API_KEY, TV_ADMIN_API_KEY,
# TV_PRIMER_BASE_URL, TV_PRIMER_SERVICE_TOKEN, TV_CHANNEL_TIMEZONE.
#
# TV_RELEASE_DIR should point at a mounted volume holding the published APK so
# the box can self-update; the APK is deliberately not baked into the image.
ENTRYPOINT ["/tv-server"]
