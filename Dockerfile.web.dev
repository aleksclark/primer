# syntax=docker/dockerfile:1.7
# Primer Vite DEV image (LMS web / TV web / investor). Source mounted at runtime.
# Pins match production SPA stages (node 22 bookworm). Do not use for production.

FROM node:22-bookworm@sha256:0557ac14e0d45d02ed563067b82856ca5e7aa3437fa28d98d4350ea9c3d9494a

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    npm_config_cache=/npm/cache

COPY scripts/compose-web-entrypoint.dev.sh /usr/local/bin/primer-web-dev-entrypoint
RUN chmod +x /usr/local/bin/primer-web-dev-entrypoint \
 && mkdir -p /npm/cache /src

WORKDIR /src
ENTRYPOINT ["/usr/local/bin/primer-web-dev-entrypoint"]
CMD ["npx", "--no-install", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
