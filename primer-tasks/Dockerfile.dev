# syntax=docker/dockerfile:1

# Development image only. Production images and deployment Dockerfiles remain
# outside this product-local stack.
FROM golang:1.26-alpine

# ffmpeg provides the ffprobe metadata boundary and decoder used to validate
# uploaded audio/video bytes. It is a runtime dependency, not a browser/native
# client dependency.
RUN apk add --no-cache git tzdata ffmpeg
# Keep the watcher version reproducible; Air remains PID 1 in Compose.
RUN go install github.com/air-verse/air@v1.61.7

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ENTRYPOINT ["air", "-c", ".air.toml"]
