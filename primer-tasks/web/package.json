{
  "name": "primer-tasks-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:client",
    "generate:client": "npm --prefix ../clients/typescript ci --no-audit --no-fund && npm --prefix ../clients/typescript run generate",
    "typecheck": "tsc -b",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "browser:test": "../scripts/browser-test",
    "browser:promoted": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "vitest --run",
    "storybook:visual": "playwright test -c playwright.mocks.config.ts",
    "storybook:visual:update": "playwright test -c playwright.mocks.config.ts --update-snapshots",
    "chromatic": "chromatic --exit-zero-on-known-changes",
    "build": "npm run typecheck && npm run test:unit && vite build",
    "test:unit": "node --experimental-strip-types --test src/*.test.ts",
    "lint": "npm run check:boundary && oxlint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/react": "^6.15.1",
    "@primer-tasks/client": "file:../clients/typescript",
    "@vitejs/plugin-react": "^6.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.11",
    "chromatic": "^18.7.2",
    "oxlint": "^1.71.0",
    "storybook": "^10.6.0",
    "typescript": "~5.9.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
