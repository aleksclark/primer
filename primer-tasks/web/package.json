{
  "name": "primer-tasks-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:client",
    "generate:client": "npm --prefix ../clients/typescript ci --no-audit --no-fund && npm --prefix ../clients/typescript run generate",
    "typecheck": "tsc -b",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "browser:test": "../scripts/browser-test",
    "build": "npm run typecheck && vite build",
    "lint": "npm run check:boundary && oxlint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primer-tasks/client": "file:../clients/typescript",
    "@vitejs/plugin-react": "^6.0.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.13.2",
    "oxlint": "^1.71.0",
    "typescript": "~5.9.0",
    "vite": "^8.1.1"
  }
}
