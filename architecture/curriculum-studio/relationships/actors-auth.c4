// Actor and identity-trust relationships (Identity design decided).

model {
  stytch_b2b -> identity_service 'Upstream B2B human-session authority; opaque validation only' {
    description '
      Primer Identity is the sole Stytch client. This relationship does
      not expose Stytch credentials to products and does not authorize
      Studio/LMS/TV roles or workspaces. Source: primer-identity-service-design.md §§1–4.
    '
  }

  teacher -> curriculum_studio.studio_ui 'Authors plans, reviews generated work, materializes windows, exports packets' {
    description '
      Source: primer-curriculum-studio-product-plan.md Product value
      proposition and Standalone product workflow.
    '
  }

  homeschool_parent -> curriculum_studio.studio_ui 'Plans a homeschool year or unit without running Primer' {
    description '
      Source: primer-curriculum-studio-product-plan.md Product concept
      (standalone use) and Phase 1 (avoid student accounts and live teaching).
    '
  }

  curriculum_author -> curriculum_studio.studio_ui 'Builds reusable curricula and templates' {
    description '
      Source: primer-curriculum-studio-product-plan.md Workspace and
      Phase 5 Collaborative authoring.
    '
  }

  teacher -> identity_service 'Authenticates through the Identity-hosted Stytch broker' {
    description '
      Identity alone validates opaque Stytch sessions and returns only
      Primer broker material. No Studio-local passwords; no dependence
      on live LMS sessions or raw Stytch material.
      Sources: primer-identity-service-design.md D1–D8;
      curriculum-studio-foundation-crosswalk.md L3–L4.
    '
  }

  homeschool_parent -> identity_service 'Authenticates through the Identity-hosted Stytch broker' {
    description '
      Same Identity path as teacher when acting as Studio author.
      Distinct from any later LMS parent product session (separate
      host-only BFF cookie).
      Source: primer-identity-service-design.md trust boundaries.
    '
  }

  curriculum_author -> identity_service 'Authenticates through the Identity-hosted Stytch broker' {
    description '
      Same Identity interactive path. Stytch organizations do not
      provision Studio tenancy; collaborative authorization remains
      local Studio product authorization.
    '
  }

  curriculum_planning_agent -> identity_service 'Obtains user-delegated or service access JWT (OAuth / client_credentials as required)' {
    description '
      MCP clients never mint Studio tokens. Identity is the authorization
      server; audience curriculum-studio; MCP scopes as registered.
      Studio may advertise protected-resource metadata pointing at Identity.
      Sources: curriculum-studio-mcp-design.md M7–M8;
      primer-identity-service-design.md §8.3.1.
    '
  }

  curriculum_planning_agent -> curriculum_studio.studio.mcp_adapter 'Streamable HTTP MCP tools (discover, draft, validate, propose publish)' {
    description '
      Single /mcp endpoint; Bearer JWT per request; tools call Studio
      domain services; human confirmation for publish.
      Source: curriculum-studio-mcp-design.md; product plan Agent MCP surface.
    '
  }

  curriculum_studio.studio_ui -> identity_service 'BFF broker redirect / Primer token acquisition' {
    description '
      Browser UI uses the Studio BFF. Host-only session cookie on the
      Studio origin; Identity issues single-audience Primer access JWTs
      (aud=curriculum-studio). Browser JS does not receive Stytch
      session material; no parent-domain cookie.
      Sources: primer-identity-service-design.md BFF pattern;
      curriculum-studio-foundation-crosswalk.md Auth presentation.
    '
  }

  curriculum_studio.studio.curriculum_api -> identity_service 'Fetches JWKS; validates access JWTs locally' {
    description '
      Studio API does not perform interactive login and does not require
      token introspection. Validates only Primer JWT signature/exp/aud/
      scope via Identity JWKS and rejects raw Stytch tokens. Authorizes via local workspace_memberships
      projections (subject_ref = identity:<uuid>).
      Sources: primer-identity-service-design.md JWKS;
      curriculum-studio-foundation-crosswalk.md subject conventions.
    '
  }

  primer_lms.lms_api -> identity_service 'Validates access JWTs via JWKS (migration target)' {
    description '
      End-state: LMS validates Identity-issued JWTs (aud=primer-lms)
      locally via JWKS. Dual-run accepts legacy parent sessions and
      static X-Service-Token until sunset stage S7.
      Sources: primer-identity-service-design.md S0–S7;
      curriculum-studio-foundation-crosswalk.md L4.
    '
  }

  primer_lms.lms_web -> identity_service 'BFF broker redirect / Primer token acquisition (migration target)' {
    description '
      LMS SPA migrates from localStorage bearer to host-only BFF
      cookies with the Identity Stytch broker. Separate browser session
      from Studio; LMS never receives a Stytch session.
      Source: primer-identity-service-design.md SPA cookie cutover.
    '
  }
}
