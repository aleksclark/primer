views {
  view identity_broker_revocation {
    title 'Candidate Primer Identity broker, webhook, token and audit topology'
    description '
      STOP pending independent exact-tip review. Required IB0 positive topology: product browser→BFF→Identity broker;
      Stytch→Identity broker and webhook receiver; Identity token/JWKS→BFF,
      Studio API/MCP and LMS API; durable internal grant/webhook/audit state.
      Required negative topology: no direct Stytch→product, MCP, Studio/LMS/
      Identity database edge. Source: agent_docs/plans/stytch-identity-ib0/.
    '
    include stytch_b2b
    include identity_service
    include identity_service.identity_broker
    include identity_service.token_authority
    include identity_service.stytch_webhook
    include identity_service.identity_audit
    include identity_service.identity_postgres
    include curriculum_studio.studio_ui
    include curriculum_studio.studio_bff
    include curriculum_studio.studio.curriculum_api
    include curriculum_studio.studio.mcp_adapter
    include curriculum_planning_agent
    include primer_lms.lms_api
    include stytch_b2b -> identity_service.identity_broker
    include stytch_b2b -> identity_service.stytch_webhook
    include curriculum_studio.studio_ui -> curriculum_studio.studio_bff
    include curriculum_studio.studio_bff -> identity_service.identity_broker
    include identity_service.identity_broker -> curriculum_studio.studio_bff
    include curriculum_studio.studio_bff -> identity_service.token_authority
    include identity_service.token_authority -> curriculum_studio.studio_bff
    include curriculum_studio.studio.curriculum_api -> identity_service.token_authority
    include identity_service.token_authority -> curriculum_studio.studio.curriculum_api
    include identity_service.token_authority -> curriculum_studio.studio.mcp_adapter
    include curriculum_studio.studio.mcp_adapter -> identity_service.token_authority
    include curriculum_planning_agent -> curriculum_studio.studio.mcp_adapter
    include curriculum_studio.studio.mcp_adapter -> curriculum_planning_agent
    include identity_service.token_authority -> curriculum_planning_agent
    include identity_service.token_authority -> primer_lms.lms_api
    include identity_service.identity_broker -> identity_service.identity_postgres
    include identity_service.token_authority -> identity_service.identity_postgres
    include identity_service.stytch_webhook -> identity_service.identity_postgres
    include identity_service.identity_audit -> identity_service.identity_postgres
    autoLayout LeftRight
  }
}
